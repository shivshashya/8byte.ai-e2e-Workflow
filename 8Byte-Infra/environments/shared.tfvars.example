# One shared AWS stack serves both staging and production containers.
# Copy to shared.tfvars; actual .tfvars files are ignored by Git.
aws_region         = "us-east-1"
aws_account_id     = ""
project_name       = "8byte-devops"
vpc_name           = "8byte-ai-vpc"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

public_subnet_cidrs  = ["10.0.0.0/24", "10.0.1.0/24"]
private_subnet_cidrs = ["10.0.10.0/24", "10.0.11.0/24"]
application_ports    = { staging = 8081, production = 8082 }
alb_listener_ports   = { staging = 8081, production = 80 }

# Choose an unused value before recreating secrets, then keep it stable.
# Set the GitHub Actions variable DATABASE_SECRET_SUFFIX to the same value.
database_secret_suffix = "build-01"

# Choose an unused final snapshot identifier for each new database deployment.
rds_final_snapshot_identifier = "petclinic-8byte-devops-final-rebuild-01"
rds_deletion_protection       = true
rds_require_tls               = false

cloudwatch_log_retention_days = 14
alb_access_log_retention_days = 30
pipeline_alert_email = "your-email@example.com"